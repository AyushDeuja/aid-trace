# Public browser configuration only. Do not place secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_URL=postgresql://aidtrace:aidtrace@localhost:5432/aidtrace
FRAUD_SERVICE_URL=http://127.0.0.1:8001
# Server-only Task 8 worker configuration. Never put key material in this file
# TRUST_WRITER_SESSION_KEY_FILE=/secure/path/aidtrace-trust-writer.json
# TRUST_WRITER_SESSION_PUBLIC_KEY=<public-key-only; safe for the admin UI>
# MAGICBLOCK_BASE_RPC_URL=https://rpc.magicblock.app/devnet
# MAGICBLOCK_ROUTER_URL=https://devnet-router.magicblock.app/
# MAGICBLOCK_ER_RPC_URL= # optional; must identify the delegated validator

